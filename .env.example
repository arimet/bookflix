# Public app keys of your two Dropbox apps (see README). Not secrets: they ship in the built JavaScript.
VITE_DROPBOX_LIBRARY_KEY=
VITE_DROPBOX_SYNC_KEY=
# Dropbox folder holding your books (read-only). Defaults to /Ebook.
VITE_LIBRARY_ROOT=/Ebook
# Optional: Google Books API key for the "Demandes" search, restricted to your site (see README).
VITE_GOOGLE_BOOKS_KEY=
